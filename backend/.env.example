# ── NetVision Environment Configuration ──────────────────────────────────
# Copy this file to .env and fill in your values.
# WARNING: Keep .env in .gitignore. Never commit secrets.

# ── Server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["*"]
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_PATH=data/netvision.db

# ── Capture ───────────────────────────────────────────────────────────────
CAPTURE_INTERFACE=eth0
CAPTURES_DIR=captures
REPORTS_DIR=reports

# ── Geolocation ───────────────────────────────────────────────────────────
GEO_CACHE_TTL=86400

# ── Health Monitoring ─────────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL=60

# ── Phase 2: Authentication ───────────────────────────────────────────────
# Generate a strong secret: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# WARNING: Using the default secret in production is insecure.
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars-long
JWT_EXPIRE_SECONDS=3600
JWT_REFRESH_EXPIRE_SECONDS=86400

# Optional API keys for programmatic/script access
# Format: comma-separated key=user:role pairs
# Example: API_KEYS=sk-netvision-abc123=admin:superadmin,sk-ci-bot-xyz789=ci-bot:viewer
API_KEYS=

# ── Phase 2: Rate Limiting ────────────────────────────────────────────────
# Max API requests per IP per window
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SECONDS=60
# Max scan starts per IP per window
SCAN_RATE_LIMIT_MAX=3
SCAN_RATE_LIMIT_WINDOW_SECONDS=300

# ── Phase 1: Alert Webhooks ───────────────────────────────────────────────
# At least one of these URLs must be set for alert delivery.
# ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/...
# ALERT_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...
# ALERT_TELEGRAM_WEBHOOK=https://api.telegram.org/bot<token>/sendMessage?chat_id=...
# ALERT_WEBHOOK_URL=https://your-webhook.example.com/alerts

# ── Phase 5: Data Retention ───────────────────────────────────────────────
PRUNE_HEALTH_DAYS=90
PRUNE_AUDIT_DAYS=30
PRUNE_CAPTURE_DAYS=7
